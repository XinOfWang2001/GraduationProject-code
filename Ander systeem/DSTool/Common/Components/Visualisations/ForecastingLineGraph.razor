@using Leap.ApplicationServices.DTO.DataResult
@using Leap.ApplicationServices.DTO.External_Services
@using ScottPlot
@using ScottPlot.Blazor

<BlazorPlot @ref=MyPlot Style="width: 100%; height: 34em;" />

@code {

    [Parameter]
    public required DataSeries ForecastData { get; set; }

    [Parameter]
    public required DataSeries OriginalData { get; set; }

    public BlazorPlot MyPlot { get; set; } = new();

    protected override void OnAfterRender(bool firstRender)
    {
        FormatForecastData(OriginalData, ForecastData);
    }

    protected override void OnParametersSet()
    {
        Console.WriteLine("It has moved!");
        base.OnParametersSet();
    }

    public void FormatForecastData(DataSeries original, DataSeries predicted)
    {
        MyPlot.Plot.Clear();
        IColormap colorMap = new ScottPlot.Colormaps.Turbo();
        // Prefix niet veranderen, tenzij prefix in Python systeem ook is veranderd.
        string predictedPrefix = "-predicted";
        int endIndexOriginal = original.Timestamps.Count();
        // Combine both datasets, specific to this implementation
        List<DateTime> originalTimeStamp = original.Timestamps.ToList();
        List<DateTime> predictedTimestamps = predicted.Timestamps.ToList();
        originalTimeStamp.AddRange(predictedTimestamps);
        // Use the original as the baseline
        foreach(var key in original.Values.Keys)
        {
            // Combine both datasets
            var relatedSet = predicted.Values[$"{key}"].ToList();
            var data = original.Values[key].ToList();
            data.AddRange(relatedSet);

            var originalData = MyPlot.Plot.Add.Scatter(originalTimeStamp[..endIndexOriginal], data[..endIndexOriginal]);
            originalData.LegendText = key;
            originalData.Smooth = true;
            // Color the first the regular color
            var colorOg = originalData.Color;
            // Then use that color them slightly differently.
            var newColor = colorOg.Darken(0.4);


            var forecastPlot = MyPlot.Plot.Add.Scatter(predictedTimestamps, relatedSet, newColor);
            // Als het een continu forecast lijn is
            // var forecastPlot = MyPlot.Plot.Add.Scatter(originalTimeStamp[(endIndexOriginal-1)..], data[(endIndexOriginal-1)..], newColor);
            forecastPlot.LegendText = $"{key}{predictedPrefix}";
            forecastPlot.Smooth = true;
        }
        MyPlot.Plot.Axes.DateTimeTicksBottom();
        MyPlot.Refresh();
    }
}