@using LeapDataScienceTool.Components.Aggregation___KPI.KPI.KPIEdit
@inject IDialogService DialogService

<MudPaper Elevation="25" Class="pa-4 my-4 w-100 align-center d-flex">
	@if (dataProcess.IsPicked)
	{
		<MudChip T="string" Color="Color.Dark">@dataProcess.Order</MudChip>
	}
	
	<MudIcon Icon="@Icons.Material.Filled.Calculate"/>
	<h5 class="m-0">@dataProcess.DataProcessType</h5>
	
	<MudSpacer />
	@if (dataProcess.IsPicked)
	{
		<MudButton Class="edit_color" OnClick="Open">Wijzig</MudButton>
	}
</MudPaper>

@code {
	[Parameter]
	public required IDataProcess dataProcess { get; set; }

	private async Task Open()
	{
		await OpenForm();
	}

	// Open dialogbox
	public async Task OpenForm()
	{
		DialogOptions dialogOptions = GetDialogOptions();
		IDialogReference result = await DialogService.ShowAsync<KPIEditDialog>("Custom config", dialogOptions);
	}

	private DialogOptions GetDialogOptions()
	{
		return new() { Position = DialogPosition.TopCenter, CloseButton = true, MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true, BackdropClick = false };
	}
}
