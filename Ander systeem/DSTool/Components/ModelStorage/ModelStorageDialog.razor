@using Leap.ApplicationServices.DTO.External_Services
@using Leap.ApplicationServices.DTO.ModelingProcess
@using Leap.ApplicationServices.Interfaces.ClientServerProxy
@using LeapDataScienceTool.Common.Components
@using LeapDataScienceTool.Common.Components.Visualisations
@using LeapDataScienceTool.PageManagers

@inject IWorkspaceManager Manager
@inject IModelOperationService ModelOperationProxyService
<MudDialog>
	<TitleContent>
		<MudText Typo="Typo.h3">Model opslaan</MudText>
	</TitleContent>
	<DialogContent>
		@if (Loading)
		{
			<ErrorMessage Message="@LoadingText" />
			<div class="container min-height-dialog">
				<MudProgressCircular Color="Color.Default" Indeterminate="true" />
			</div>
		}
		else 
		{
			@if (StorageDTO != null)
			{
				<MudAlert Variant="Variant.Filled" Severity="Severity.Success">@SuccesfullText</MudAlert>
			}
			else if (ExistingModel == null)
			{
				<MudAlert Variant="Variant.Filled" Severity="Severity.Warning">@LoadingText</MudAlert>
			}
			else
			{
				<MudAlert Variant="Variant.Filled" Severity="Severity.Error">@LoadingText</MudAlert>
			}
		}
		
	</DialogContent>
	<DialogActions>
		@if (StorageDTO != null)
		{
			<MudButton Class="delete_color ms-1" onclick="Close" Disabled=@Loading>Blijf</MudButton>
			<MudButton Class="action_color ms-1" Href="workspace" Disabled=@Loading>Ga terug naar het startmenu</MudButton>
		}
		else if(ExistingModel != null)
		{
			<MudButton Class="delete_color ms-1" onclick="Close" Disabled=@Loading>Nee</MudButton>
			<MudButton Class="action_color ms-1" onclick="OverwriteModel" Disabled=@Loading>Ja</MudButton>
		}
		else
		{
			<MudButton Class="delete_color ms-1" onclick="Close">Sluit af</MudButton>
		}
	</DialogActions>
</MudDialog>


@code {
	[CascadingParameter]
	public required IMudDialogInstance MudDialog { get; set; }

	public bool Loading { get; set; } = true;
	public string LoadingText { get; set; } = string.Empty;
	public string SuccesfullText { get; set; } = string.Empty;

	public ModelStorageDTO? StorageDTO { get; set; }
	public ModelStorageDTO? ExistingModel { get; set; }

	protected override void OnInitialized()
	{
		Loading = true;
		LoadingText = "Model zal nu opgeslagen worden.";
		base.OnInitialized();
	}

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var request = SetupRequest();
			// Check if model exists.
			// If yes, show overwritten text. (User friendliness)
			// If not, immediately store model. (User friendliness)
			ExistingModel = await ModelOperationProxyService.GetModelStorage(request.WorkspaceGuid);
			if (ExistingModel == null)
			{
				await PushChanges(request);
			}
			else
			{
				LoadingText = "Weet je zeker dat je het huidige model wil overschrijven?";
			}
			await base.OnInitializedAsync();
		}
		catch
		{
			LoadingText = "Stel eerst een databron en model in, voordat een model opgeslagen wordt.";

		}
		finally
		{
			Loading = false;
		}
	}

	public async Task OverwriteModel()
	{
		var request = SetupRequest();
		request.Overwrite = true;
		await PushChanges(request);
	}

	private async Task PushChanges(ModelStorageCreationRequestDTO request)
	{
		Loading = true;
		StorageDTO = await ModelOperationProxyService.TriggerModelStorage(request);
		if (StorageDTO == null)
		{
			LoadingText = "Er is iets misgegaan bij het opslaan van het model. Controlleer even de databron en modelconfiguratie gegevens.";
		}
		else
		{
			SuccesfullText = "Model is succesvol opgeslagen.";
		}
		Loading = false;
	}

	private ModelStorageCreationRequestDTO SetupRequest()
	{
		var WorkspaceData = Manager.GetWorkspaceConfigDTO();
		var DataExtractData = Manager.GetDataExtractConfigDTO();
		var ModelConfigData = Manager.GetModelConfig();
		// Combine data into one
		return new ()
		{
			DataExtractConfigGuid = DataExtractData.ProcessId,
			WorkspaceGuid = WorkspaceData.WorkspaceGuid,
			ModelConfigGuid = ModelConfigData.ModelConfigGuid
		};
	}

	private void Close() => MudDialog.Cancel();
}
